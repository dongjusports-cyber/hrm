  <td class=xl31 style='border-top:none;border-left:none' x:num>41</td>
  
  <td class=xl31 style='border-top:none;border-left:none' x:num>42</td>
  
 </tr>
 <%
 	Dim tt_emp,tt_sal_pro,tt_sal_basic,tt_wd_pro,tt_wd_off,tt_wd,tt_sal_wd
	Dim tt_indus,tt_pos,tt_tech,tt_trans,tt_train,tt_health,tt_ser,tt_allow,tt_ot,tt_sal_ot,tt_return,tt_gross,tt_union
	Dim tt_social,tt_BHYT,tt_income,tt_income_tax,tt_net,tt_ale,tt_rem,tt_nt,tt_nt_amt,tt_deduct_other,tt_unemp_ins
	Dim tt_ot_no_tax,tt_family_deduct,tt_other
	
	tt_emp=0
	tt_sal_pro=0
	tt_sal_basic=0
	tt_wd_pro=0
	tt_wd_off=0
	tt_wd=0
	tt_sal_wd=0
	tt_indus=0
	tt_pos=0
	tt_tech=0
	tt_trans=0
	tt_train=0
	tt_health=0
	tt_ser=0
	tt_other=0
	tt_other_all=0
	tt_allow=0
	tt_ot=0
	tt_sal_ot=0
	tt_return=0
	tt_gross=0
	tt_social=0
	tt_BHYT=0
	tt_income=0
	tt_income_tax=0
	tt_net=0
	tt_ale=0
	tt_rem=0
	tt_nt=0
	tt_nt_amt=0
	tt_deduct_other=0
	tt_unemp_ins=0
	tt_ot_no_tax=0
	tt_family_deduct=0
	tt_union=0
	Dim i,dem
	dem=0
	for i=0 to TotalEmp-1
		tt_emp=tt_emp + 1
		tt_sal_pro=tt_sal_pro + Cdbl(Emp(6,i))
		tt_sal_basic=tt_sal_basic + Cdbl(Emp(7,i))
		tt_wd_pro=tt_wd_pro + Cdbl(Emp(8,i))
		tt_wd_off=tt_wd_off + Cdbl(Emp(9,i))
		tt_wd=tt_wd + Cdbl(Emp(10,i))
		tt_sal_wd=tt_sal_wd + Cdbl(Emp(11,i))
		tt_indus=tt_indus + Cdbl(Emp(12,i))
		tt_pos=tt_pos + Cdbl(Emp(13,i))
		tt_tech=tt_tech + Cdbl(Emp(14,i))
		tt_trans=tt_trans + Cdbl(Emp(15,i))
		tt_train=tt_train + Cdbl(Emp(16,i))
		tt_health=tt_health + Cdbl(Emp(17,i))
		tt_ser=tt_ser + Cdbl(Emp(18,i))
		tt_allow=tt_allow + Cdbl(Emp(19,i))
		tt_ot=tt_ot + Cdbl(Emp(20,i))
		tt_sal_ot=tt_sal_ot + Cdbl(Emp(21,i))
		tt_return=tt_return + Cdbl(Emp(25,i))
		tt_gross=tt_gross + Cdbl(Emp(27,i))
		tt_social=tt_social + Cdbl(Emp(28,i))
		tt_BHYT=tt_BHYT + Cdbl(Emp(29,i))
		tt_income=tt_income + Cdbl(Emp(33,i))
		tt_income_tax=tt_income_tax + Cdbl(Emp(32,i))
		tt_net=tt_net + Cdbl(Emp(36,i))
		tt_ale=tt_ale + Cdbl(Emp(39,i))
		tt_rem=tt_rem + Cdbl(Emp(40,i))
		tt_nt=tt_nt  + Cdbl(Emp(41,i))
		tt_nt_amt=tt_nt_amt + Cdbl(Emp(22,i))
		tt_deduct_other=tt_deduct_other + Cdbl(Emp(31,i))
		tt_unemp_ins=tt_unemp_ins + Cdbl(Emp(42,i))
		tt_ot_no_tax=tt_ot_no_tax + Cdbl(Emp(43,i))
		tt_family_deduct=tt_family_deduct + Cdbl(Emp(44,i))
		tt_union = 	tt_union +  Cdbl(Emp(30,i))
		tt_other=tt_other+Cdbl(Emp(45,i))

		dem = dem + 1
		
	'if (strcomp(Emp(38,i+1),Emp(38,i)<>0) and i<>0 then
		'dem = 0
	'end if
%>
 <tr height=25 style='mso-height-source:userset;height:18.95pt'>
  <td height=25 class=xl29 style='height:18.95pt;border-top:none' x:num><%=dem%></td>
  <td class=xl27 style='border-top:none;border-left:none'><%=Emp(0,i)%></td>
  <td class=xl27 style='border-top:none;border-left:none' x:num><%=Emp(1,i)%></td>
  <td class=xl27 style='border-top:none;border-left:none'><%=Emp(2,i)%></td>
  <td class=xl27 style='border-top:none;border-left:none'>&nbsp;</td>
  <td class=xl27 style='border-top:none;border-left:none'><%=Emp(3,i)%></td>
  <td class=xl26 style='border-top:none;border-left:none'><%=Emp(4,i)%></td>
  <td class=xl26 style='border-top:none;border-left:none'><%=Emp(5,i)%></td>
  <td class=xl28 style='border-top:none;border-left:none' x:num=""><%=Emp(6,i)%></td>
  <td class=xl28 style='border-top:none;border-left:none' x:num=""><%=Emp(7,i)%></td>
  <td class=xl29 style='border-top:none;border-left:none' x:num><%=Emp(8,i)%></td>
  <td class=xl29 style='border-top:none;border-left:none' x:num><%=Emp(9,i)%></td>
  <td class=xl29 style='border-top:none;border-left:none' x:num><%=Emp(10,i)%></td>
  <td class=xl29 style='border-top:none;border-left:none' x:num=""><%=Emp(39,i)%></td>
  <td class=xl29 style='border-top:none;border-left:none' x:num=""><%=Emp(40,i)%></td>  
  <td class=xl30 style='border-top:none;border-left:none' x:num=""><%=Emp(11,i)%></td>
  <td class=xl30 style='border-top:none;border-left:none' x:num=""><%=Emp(12,i)%></td>
  <td class=xl30 style='border-top:none;border-left:none' x:num=""><%=Emp(13,i)%></td>
  <td class=xl30 style='border-top:none;border-left:none' x:num=""><%=Emp(14,i)%></td>
  <td class=xl30 style='border-top:none;border-left:none' x:num=""><%=Emp(15,i)%></td>
  <td class=xl30 style='border-top:none;border-left:none' x:num=""><%=Emp(16,i)%></td>
  <td class=xl30 style='border-top:none;border-left:none' x:num=""><%=Emp(17,i)%></td>
  <td class=xl30 style='border-top:none;border-left:none' x:num=""><%=Emp(18,i)%></td>
  <td class=xl30 style='border-top:none;border-left:none' x:num=""><%=Emp(45,i)%></td>
  <td class=xl30 style='border-top:none;border-left:none' x:num=""><%=Emp(19,i)%></td>
  <td class=xl28 style='border-top:none;border-left:none' x:num=""><%=Emp(20,i)%></td>
  <td class=xl28 style='border-top:none;border-left:none' x:num=""><%=Emp(21,i)%></td>
  <td class=xl28 style='border-top:none;border-left:none' x:num=""><%=Emp(41,i)%></td>
  <td class=xl28 style='border-top:none;border-left:none' x:num=""><%=Emp(22,i)%></td>
  <td class=xl28 style='border-top:none;border-left:none' x:num=""><%=Emp(25,i)%></td>
  <td class=xl28 style='border-top:none;border-left:none' x:num=""><%=Emp(27,i)%></td>
  <td class=xl28 style='border-top:none;border-left:none' x:num=""><%=Emp(43,i)%></td>
  <td class=xl28 style='border-top:none;border-left:none' x:num="">-</td>
  <td class=xl28 style='border-top:none;border-left:none' x:num=""><%=Emp(28,i)%></td>
  <td class=xl28 style='border-top:none;border-left:none' x:num=""><%=Emp(29,i)%></td>
  <td class=xl28 style='border-top:none;border-left:none' x:num=""><%=Emp(42,i)%></td>
  <td class=xl28 style='border-top:none;border-left:none' x:num=""><%=Emp(30,i)%></td>
  <td class=xl28 style='border-top:none;border-left:none' x:num=""><%=Emp(31,i)%></td>
  <td class=xl28 style='border-top:none;border-left:none' x:num=""><%=Emp(33,i)%></td>
  <td class=xl28 style='border-top:none;border-left:none' x:num="">-</td>
  <td class=xl53 style='border-top:none;border-left:none' x:num=""><%=Emp(36,i)%></td>
  
  <td class=xl28 style='border-top:none;border-left:none' x:num="">
  <%
  if Emp(46,i)=0 then  Response.write("Nữ")  else  Response.write("Nam")
  %>
  </td>
  
 </tr>
 <%
	next
 %>
 
