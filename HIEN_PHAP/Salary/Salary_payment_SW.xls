  <td class=xl49 style='border-top:none;border-left:none' x:num="">-</td>
  <td class=xl49 style='border-top:none;border-left:none' x:num=""><%=tt_net%></td>
  <td class=xl49 style='border-top:none;border-left:none' x:num="">-</td>
