<% 
		Response.ContentType = "application/x-excel" 
		'Response.Buffer=False
%>
<html xmlns:v="urn:schemas-microsoft-com:vml"
xmlns:o="urn:schemas-microsoft-com:office:office"
xmlns:x="urn:schemas-microsoft-com:office:excel"
xmlns="http://www.w3.org/TR/REC-html40">
<!-- #include file="../dbhr.inc"  -->
<% ConnectDBApp %>
<%
	dim v_title

	dim dat,mm,yyyy
	dim v_dept,v_group	
	dim v_emp_id

	dat = request.querystring("Month")
	v_dept=request.querystring("dept")
	v_group = request.querystring("group")
	v_status = request.querystring("status")
	v_emp_id = request.querystring("emp_id")
    sqlDate = "SELECT TO_CHAR(TO_DATE('" & dat & "','YYYYMM'),'Month') || ' ' || TO_CHAR(TO_DATE('" & dat & "','YYYYMM'),'YYYY')  FROM DUAL "
	TableReadOpen rs1, sqlDate

If	Not(rs1.BOF and rs1.EOF) then
	v_title = UCase(rs1(0)) 
End if
	
	mm = right(dat,2)
	yyyy= left(dat,4)
	
SQL = " SELECT   d.workgrp_nm AS grp_nm_0, "
SQL = SQL & "         a.EMP_ID as emp_id_1, "
SQL = SQL & "         a.FULL_NM as name_2, "
SQL = SQL & "         e.POS_NM as pos_3, "
SQL = SQL & "         to_char(to_date(a.JOIN_DATE,'yyyymmdd'),'dd/mm/yyyy') as join_dt_4, "
SQL = SQL & "         to_char(to_date(a.ST_CONTRACT,'yyyymmdd'),'dd/mm/yyyy') as st_contract_5, "
SQL = SQL & "         e.PRO_SALARY as sal_pro_6, "
SQL = SQL & "         e.BASIC_SAL as sal_basic_7, "
SQL = SQL & "         NVL (e.wt_pro, 0) + NVL (e.HOL_pro, 0) AS wt_pro_8, "
SQL = SQL & "         NVL (e.wt_off, 0) + NVL (e.HOL_off, 0) AS wt_off_9, "
SQL = SQL & "         ROUND(NVL (e.wt_pro, 0) + NVL (e.wt_off, 0) + NVL (e.HOL_pro, 0) + NVL (e.HOL_off, 0),4) AS wt_total_10, "
SQL = SQL & "           round(NVL (e.wt_off_amt, 0) "
SQL = SQL & "         + NVL (e.wt_pro_amt, 0) "
SQL = SQL & "         + NVL (e.hol_off_amt, 0) "
SQL = SQL & "         + NVL (e.hol_pro_amt, 0) "
SQL = SQL & "         + NVL (e.abs_total_day_off_amt, 0) "
SQL = SQL & "         + NVL (e.abs_total_day_pro_amt, 0) "
SQL = SQL & "         + NVL (e.ale_pit_amt, 0),0) AS sal_wd_11, "
SQL = SQL & "         NVL (e.indus_amt, 0) AS indus_12, "
SQL = SQL & "         NVL (e.pos_all, 0) AS pos_all_13, "
SQL = SQL & "         NVL (e.tech_amt, 0) AS tech_all_14, "
SQL = SQL & "         NVL (e.trans_amt, 0) AS trans_all_15, "
SQL = SQL & "         NVL (e.train_all, 0) AS train_all_16, "
SQL = SQL & "         NVL (e.treat_all, 0) AS treat_all_17, NVL(e.ser_amt, 0) as ser_amt_18 , "
SQL = SQL & "           NVL (e.indus_amt, 0) "
SQL = SQL & "         + NVL (e.pos_all, 0) "
SQL = SQL & "         + NVL (e.tech_amt, 0) "
SQL = SQL & "         + NVL (e.trans_amt, 0) "
SQL = SQL & "         + NVL (e.train_all, 0) "
SQL = SQL & "         + NVL (e.treat_all, 0) + NVL(e.ser_amt, 0) + NVL(e.other_amt, 0) AS total_all_19, "
SQL = SQL & "           NVL (e.ot_day_pro, 0) "
SQL = SQL & "         + NVL (e.ot_day_off, 0) "
SQL = SQL & "         + NVL (e.ot_night_pro, 0) "
SQL = SQL & "         + NVL (e.ot_night_off, 0) AS hour_ot_20, "
SQL = SQL & "           NVL (ot_tot_off_amt, 0) "
SQL = SQL & "         + NVL (ot_tot_pro_amt, 0) AS sal_ot_21, "
SQL = SQL & "           NVL (nt30_pro_amt, 0) "
SQL = SQL & "         + NVL (nt45_pro_amt, 0) "
SQL = SQL & "         + NVL (nt60_pro_amt, 0) "
SQL = SQL & "         + NVL (nt30_off_amt, 0) "
SQL = SQL & "         + NVL (nt45_off_amt, 0) "
SQL = SQL & "         + NVL (nt60_off_amt, 0) AS nt_22, "
SQL = SQL & "         NVL (inc_amt, 0) AS thuong_23, "
SQL = SQL & "         NVL (severance_amt, 0) AS tctv_24, "
SQL = SQL & "         NVL (adj_amt, 0) AS return_25, "
SQL = SQL & "         NVL (e.annual_stop_amt, 0) AS ale_stop_amt_26, "
SQL = SQL & "         NVL (e.gross_amt, 0) AS gross_27, "
SQL = SQL & "         NVL (e.social_amt, 0) AS social_28, "
SQL = SQL & "         NVL (e.health_amt, 0) AS health_29, "
SQL = SQL & "         NVL (union_amt, 0) AS union_30, "
SQL = SQL & "           NVL (adv_amt, 0) "
SQL = SQL & "         + NVL (e.health_card, 0) "
SQL = SQL & "         + NVL (e.equipment, 0) AS other_deduct_31, "
SQL = SQL & "         NVL (income_tax, 0) AS income_tax_32, "
SQL = SQL & "         NVL (e.income_before_tax_amt, 0)		"
SQL = SQL & "         - NVL(e.SOCIAL_AMT,0) 	"
SQL = SQL & "         - NVL(e.HEALTH_AMT,0)		"
SQL = SQL & "         - nvl(unemp_ins_amt,0) AS income_33, "
SQL = SQL & "         NVL (e.pit_finalize, 0) AS pit_final_34, "
SQL = SQL & "         NVL (e.remaining_card_amt, 0) AS card_amt_35, "
SQL = SQL & "         round(NVL (net_amt, 0),0) AS net_amt_36, "
SQL = SQL & "         NVL (e.incentive_prod, 0) AS inc_prod_37, "
SQL = SQL & "         e.GRP_CODE as grp_code_38, "
SQL = SQL & "         nvl(e.abs_ale_pro,0) + nvl(e.abs_ale_off,0) as abs_ale_39, "
SQL = SQL & "         NVL (e.abs_total_day_off, 0) "
SQL = SQL & "         + NVL (e.abs_total_day_pro, 0) - nvl(e.abs_ale_pro,0) - nvl(e.abs_ale_off,0) as abs_rem_40, "
SQL = SQL & "           NVL (nt30_pro, 0) "
SQL = SQL & "         + NVL (nt45_pro, 0) "
SQL = SQL & "         + NVL (nt60_pro, 0) "
SQL = SQL & "         + NVL (nt30_off, 0) "
SQL = SQL & "         + NVL (nt45_off, 0) "
SQL = SQL & "         + NVL (nt60_off, 0) AS sal_nt_41, "
SQL = SQL & "         nvl(unemp_ins_amt,0) AS UNEMP_INS_AMT_42, "
SQL = SQL & "         NVL (ot_tot_off_amt, 0) "
SQL = SQL & "         + NVL (ot_tot_pro_amt, 0) "
SQL = SQL & "         + NVL (nt30_pro_amt, 0) "
SQL = SQL & "         + NVL (nt45_pro_amt, 0) "
SQL = SQL & "         + NVL (nt60_pro_amt, 0) "
SQL = SQL & "         + NVL (nt30_off_amt, 0) "
SQL = SQL & "         + NVL (nt45_off_amt, 0) "
SQL = SQL & "         + NVL (nt60_off_amt, 0) "
SQL = SQL & "         - NVL (ot_tot_100_off_amt, 0) "
SQL = SQL & "         - NVL (ot_tot_100_pro_amt, 0) as ot_no_tax_43,"
SQL = SQL & "         NVL (family_deduct_amt, 0) as family_deduct_44, NVL(other_amt,0) as other_amt_45 ,	"

SQL = SQL & "  a.SEX as sex_46  "

SQL = SQL & "    FROM thr_salary_emp e, "
SQL = SQL & "         thr_abworkgrp d, "
SQL = SQL & "         thr_abemp a, "
SQL = SQL & "         (SELECT   a.emp_pk, SUM (NVL (a.mon_cnt, 0)) AS num_ale "
SQL = SQL & "              FROM vhr_emp_absent_cnt a "
SQL = SQL & "             WHERE SUBSTR (a.yearmon, 1, 4) = SUBSTR ('" & dat & "', 1, 4) "
SQL = SQL & "          GROUP BY a.emp_pk) ale "
SQL = SQL & "   WHERE e.del_if = 0 "
SQL = SQL & "     AND a.del_if = 0 "
SQL = SQL & "     AND a.pk = e.emp_pk "
SQL = SQL & "     AND ale.emp_pk(+) = e.emp_pk "
SQL = SQL & "     AND d.del_if = 0 "
SQL = SQL & "     AND e.grp_code = d.pk "
SQL = SQL & "     AND e.work_mon = '" & dat & "' "
SQL = SQL & "     AND (A.JOIN_DATE <= '" & dat & "' || '31' OR A.JOIN_DATE IS NULL) "
SQL = SQL & "     AND (A.LEFT_DATE >= '" & dat & "' || '01'  OR A.LEFT_DATE IS NULL) "
SQL = SQL & "     AND DECODE ('" & v_dept & "', 'ALL', 'ALL', e.dept_pk) = '" & v_dept & "' "
SQL = SQL & "     AND DECODE ('" & v_group & "', 'ALL', 'ALL', e.GRP_CODE) = '" & v_group & "' "
SQL = SQL & "     AND DECODE ('" & v_status & "', 'ALL', 'ALL', e.STATUS) = '" & v_status & "' "
SQL = SQL & "     and e.EMP_ID like '%' || '" & v_emp_id & "' "
SQL = SQL & "     AND nvl(E.NET_AMT,0) >= 0 "
SQL = SQL & "ORDER BY d.workgrp_nm,a.EMP_ID "
	
	'response.write SQL
	'response.end

  TableReadOpen rec, SQL
	if not rec.eof then		
		Emp = rec.GetRows()
		TotalEmp = Ubound(Emp, 2) + 1
	Else
		TotalEmp = 0
		response.write "There is no data"
		response.end
	end if
%>
