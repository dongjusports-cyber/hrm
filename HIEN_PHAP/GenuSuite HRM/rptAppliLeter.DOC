
<% Response.ContentType = "application/msword"
	Response.Buffer=false %>
<!-- #include file="../../../system/lib/form.inc"  -->
<!-- #include file="../db.inc"  -->
<html xmlns:v="urn:schemas-microsoft-com:vml"
xmlns:o="urn:schemas-microsoft-com:office:office"
xmlns:w="urn:schemas-microsoft-com:office:word"
xmlns:st1="urn:schemas-microsoft-com:office:smarttags"
xmlns="http://www.w3.org/TR/REC-html40">

<%
	Dim pklist 
	Dim v_dept,v_empid,v_remark,v_fullnm,v_cardid,v_fromDOJ,v_toDOJ,v_kindLB,v_fromET_Probation,v_toET_Probation,v_fromET_Contract,v_toET_Contract,v_printBack
	Dim DateLB
	pklist 				= request.querystring("p_PKList")	
	v_dept 				= request.querystring("dept") 		
	v_emp_id 			= request.querystring("emp_id")
	'v_remark 			= request.querystring("old_code")
	'v_fullnm 			= request.querystring("full_nm")
	'v_cardid 			= request.querystring("card_id")
	'v_fromDOJ 			= request.querystring("fromDOJ")
	'v_toDOJ 			= request.querystring("toDOJ")
	v_kindLB 			= request.querystring("kindLB")
	'v_fromET_Probation 	= request.querystring("fromET_Probation")
	'v_toET_Probation 	= request.querystring("toET_Probation")
	'v_fromET_Contract 	= request.querystring("fromET_Contract")
	'v_toET_Contract 	= request.querystring("toET_Contract")
	v_printBack			= request.querystring("printBack")
	
	if v_kindLB="1" then
		v_kindLB="One year"
	else
		v_kindLB="Indefinite"
	end if
	
	DateLB=Day(Now()) & "/" & Month(Now()) & "/" & Year(Now())
%>

<%
	Dim emp, empTotal,stSQL

	ConnectDBApp
		stSQL = " SELECT E.EMP_ID AS COL0"
		stSQL = stSQL &  " 	   ,E.FULL_NM AS COL1"
		stSQL = stSQL &  " 	   ,POS.CODE_NM AS COL2, POS.CODE_LNM AS COL3"
		stSQL = stSQL &  " 	   ,TO_CHAR(TO_DATE(E.JOIN_DATE,'YYYYMMDD'),'DD/MM/YYYY') AS COL4"
		stSQL = stSQL &  " 	   ,ROUND(MONTHS_BETWEEN(TO_DATE(E.ET_PROBATION,'YYYYMMDD'),TO_DATE(E.ST_PROBATION,'YYYYMMDD'))) AS COL5"
		stSQL = stSQL &  " 	   ,NVL(EM.PROB_SALARY,0) + EM.OTHER_AMT AS COL6"
		stSQL = stSQL &  " 	   ,NVL(EM.BASIC_SAL,0) AS COL7"
		stSQL = stSQL &  " 	   ,NVL(EM.INDUS_ALLOW,0) AS COL8"
		stSQL = stSQL &  " 	   ,NVL(EM.POS_AMT,0) AS COL9"
		stSQL = stSQL &  " 	   ,NVL(EM.TECH_AMT,0) AS COL10"
		stSQL = stSQL &  " 	   ,NVL(EM.TRAIN_ALLOW,0) AS COL11"
		stSQL = stSQL &  " 	   ,NVL(EM.TRANS_ALLOW,0) AS COL12"
		stSQL = stSQL &  " 	   ,(NVL(EM.PROB_SALARY,0) + NVL(EM.INDUS_ALLOW,0) + NVL(EM.POS_AMT,0) + NVL(EM.TECH_AMT,0) + NVL(EM.TRAIN_ALLOW,0) + NVL(EM.TRANS_ALLOW,0) + NVL(EM.TREAT_ALLOW,0)) AS TOT_PRO_SAL_13"
		stSQL = stSQL &  " 	   ,(NVL(EM.BASIC_SAL,0) + NVL(EM.INDUS_ALLOW,0) + NVL(EM.POS_AMT,0) + NVL(EM.TECH_AMT,0) + NVL(EM.TRAIN_ALLOW,0) + NVL(EM.TRANS_ALLOW,0) + NVL(EM.TREAT_ALLOW,0)) AS TOT_OFF_SAL_14,NVL(EM.BASIC_SAL,0) *0.9,EM.OTHER_AMT "
stSQL = stSQL &  " 	   ,(case when e.SEX =0 then 'Nữ'else 'Nam' end) as COL17"
stSQL = stSQL &  " 	   ,TO_CHAR(TO_DATE(E.BIRTH_DATE,'YYYYMMDD'),'DD/MM/YYYY') AS COL18"
stSQL = stSQL &  " 	   ,E.PERSON_ID AS COL19"
stSQL = stSQL &  " 	   ,E.ADDR AS COL20"
stSQL = stSQL &  " 	   ,JOB.CODE_NM AS COL21"
stSQL = stSQL &  " 	   ,JOB.CODE_LNM AS COL22"

stSQL = stSQL &  " 	   ,NVL(EM.TREAT_ALLOW,0) AS COL23"
stSQL = stSQL &  " 	   ,TO_CHAR(ADD_MONTHS(TO_DATE(E.JOIN_DATE,'YYYYMMDD')-1,1),'DD/MM/YYYY') AS COL24"

		stSQL = stSQL &  "   FROM THR_ABEMP E,"
		stSQL = stSQL &  "        THR_ABEMPMAS EM,"
		stSQL = stSQL &  "        THR_LABOUR_CONTRACT L,"
		stSQL = stSQL &  "        (SELECT   CODE,CODE_LNM, CODE_NM"
		stSQL = stSQL &  "         FROM COMM.TCO_ABCODE"
		stSQL = stSQL &  "         WHERE TCO_ABCODEGRP_PK = (SELECT PK"
		stSQL = stSQL &  "                                   FROM COMM.TCO_ABCODEGRP"
		stSQL = stSQL &  "                                   WHERE ID = 'HRAB0060') AND DEL_IF = 0"
		stSQL = stSQL &  "         ORDER BY CODE_NM) POS"

stSQL = stSQL &  " 		,(SELECT   CODE, CODE_LNM, CODE_NM"
stSQL = stSQL &  "            FROM COMM.TCO_ABCODE"
stSQL = stSQL &  "            WHERE TCO_ABCODEGRP_PK = (SELECT PK "
stSQL = stSQL &  "                                        FROM COMM.TCO_ABCODEGRP"
stSQL = stSQL &  "                                       WHERE ID = 'HRAB0100') AND DEL_IF = 0"
stSQL = stSQL &  "         ORDER BY CODE_NM) JOB"

		stSQL = stSQL &  " WHERE E.DEL_IF =0 AND EM.DEL_IF = 0 AND L.DEL_IF = 0"
		stSQL = stSQL &  " 	  AND E.PK = EM.THR_ABEMP_PK"
		stSQL = stSQL &  " 	  AND EM.POS_CODE = POS.CODE(+) "
stSQL = stSQL &  "    AND EM.JOB_CODE = JOB.CODE"
		stSQL = stSQL &  " 	  AND E.PK = L.THR_ABEMP_PK"
		stSQL = stSQL &  " 	  AND L.KIND_CONTRACT = 0 AND E.PK IN ( " & Left(pklist, Len(pklist) - 1) & ")  "
		
		'Response.Write stSQL
		'Response.End
				
		TableReadOpen rs, stSQL
		if not rs.eof then
			emp = rs.getrows()
			empTotal = ubound(emp,2) + 1
		else
			empTotal = 0
			Response.write "There is no data"
			Response.end
		end if
	CloseDB
%>
