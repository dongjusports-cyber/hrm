# DJ HRM — mẫu LOCAL (copy thành .env, KHÔNG commit)
# Production: xem .env.prod.example + ops/DEPLOY_VPS.md

APP_ENV=local

# PostgreSQL
POSTGRES_USER=djhrm
POSTGRES_PASSWORD=djhrm_local_change_me
POSTGRES_DB=djhrm
DATABASE_URL=postgresql+psycopg://djhrm:djhrm_local_change_me@postgres:5432/djhrm

# Redis
REDIS_URL=redis://redis:6379/0

# JWT (đổi khi lên production)
JWT_SECRET=change_me_to_a_long_random_string
JWT_ACCESS_HOURS=8
JWT_REFRESH_DAYS=7

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Web local (Docker): VITE_API_BASE_URL=same-origin + proxy /api → api:8000 (xem docker-compose)
TRUSTED_HOSTS=*
LOG_DIR=logs

# Gemini
GEMINI_API_KEY=

# Agent Mitapro
AGENT_TOKEN=change_me_agent_token

# Backup (ops/backup.ps1 | ops/backup.sh)
# BACKUP_DIR=./backups
# BACKUP_KEEP_DAYS=30
# POSTGRES_CONTAINER=djhrm-postgres

# Seed Admin — đổi ngay sau lần đăng nhập đầu
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@DongJu2026
ADMIN_FULL_NAME=Nguyễn Thanh Thiện
