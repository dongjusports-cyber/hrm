# P6.1 — Agent nhà máy trỏ Cloud VPS (HTTPS)
# Copy thành .env trên máy Mitapro — KHÔNG commit

# URL HTTPS công khai (không dùng http:// trên cloud)
DJ_API_BASE_URL=https://hrm.example.com
DJ_AGENT_TOKEN=doi_trung_voi_AGENT_TOKEN_tren_VPS
DJ_AGENT_REQUIRE_HTTPS=1

MITAPRO_ODBC=Driver={ODBC Driver 17 for SQL Server};Server=.\SQLEXPRESS;Database=MITACOSQL;Trusted_Connection=yes;TrustServerCertificate=yes;

SYNC_INTERVAL_MINUTES=15
SYNC_OVERLAP_MINUTES=30
SYNC_LOOKBACK_DAYS=3
DJ_AGENT_MOCK_SQL=0
STATE_FILE=./agent_state.json
AGENT_NAME=dj-agent-mitapro-factory
