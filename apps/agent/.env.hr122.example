# Copy file này thành .env trên máy HR-Nhu (192.168.1.122 — có Mitapro/SQL)
# Token phải TRÙNG AGENT_TOKEN trong .env Docker trên máy 192.168.1.123

DJ_API_BASE_URL=http://192.168.1.123:8000
DJ_AGENT_TOKEN=DjHrm-Mitapro-20260812-571983
DJ_AGENT_REQUIRE_HTTPS=0

# Driver: phai cai "ODBC Driver 17/18 for SQL Server" tren may .122
# Chay KIEM_TRA_ODBC.bat de xem ten driver chinh xac
MITAPRO_ODBC=Driver={ODBC Driver 17 for SQL Server};Server=.\SQLEXPRESS;Database=MITACOSQL;Trusted_Connection=yes;TrustServerCertificate=yes;
# Neu da cai Driver 18, doi thanh:
# MITAPRO_ODBC=Driver={ODBC Driver 18 for SQL Server};Server=.\SQLEXPRESS;Database=MITACOSQL;Trusted_Connection=yes;TrustServerCertificate=yes;

SYNC_INTERVAL_MINUTES=15
SYNC_OVERLAP_MINUTES=30
SYNC_LOOKBACK_DAYS=3
DJ_AGENT_MOCK_SQL=0
STATE_FILE=./agent_state.json
AGENT_NAME=dj-agent-hr122
