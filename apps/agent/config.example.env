# Copy thành .env trên máy Mitapro — KHÔNG commit .env thật

# API DJ HRM (local). Cloud: dùng config.cloud.example.env (HTTPS)
DJ_API_BASE_URL=http://127.0.0.1:8000
DJ_AGENT_TOKEN=change_me_agent_token
DJ_AGENT_REQUIRE_HTTPS=0

# SQL Server Mitapro (read-only login khuyến nghị)
MITAPRO_ODBC=Driver={ODBC Driver 17 for SQL Server};Server=.\SQLEXPRESS;Database=MITACOSQL;Trusted_Connection=yes;TrustServerCertificate=yes;

# Vòng sync (phút). 0 = chỉ chạy 1 lần rồi thoát
SYNC_INTERVAL_MINUTES=15

# Mỗi lần đọc lùi thêm (phút) để không sót punch biên
SYNC_OVERLAP_MINUTES=30

# Lần đầu chưa có watermark: lấy N ngày gần nhất
SYNC_LOOKBACK_DAYS=3

# 1 = không cần SQL Server (dùng dữ liệu giả để test Agent ↔ API)
DJ_AGENT_MOCK_SQL=0

# File nhớ mốc đồng bộ gần nhất
STATE_FILE=./agent_state.json
